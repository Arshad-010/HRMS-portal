# ========================================================
# HRMS Portal - Monorepo Master Environment Variables Reference
# ========================================================

# --------------------------------------------------------
# 1. Backend Service Configuration (backend/.env)
# --------------------------------------------------------
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/hrms_portal
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173

# Admin Initial Bootstrap Credentials (used by npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# Two-Factor Authentication (2FA) Secret Key
TWO_FACTOR_SECRET_KEY=your_two_factor_encryption_secret_key_32_chars

# Email Service Configuration (SMTP / Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Admin SDK Configuration (Backend Token Verification)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# --------------------------------------------------------
# 2. Frontend Application Configuration (frontend/.env)
# --------------------------------------------------------
VITE_API_URL=http://localhost:5001/api

# Frontend Firebase SDK Configuration (Web Client)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
