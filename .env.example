# ========================================================
# HRMS Portal - Root Environment Variables Reference
# ========================================================

# Backend Configuration (copied into backend/.env)
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/hrms_portal
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Frontend Configuration (copied into frontend/.env)
VITE_API_URL=http://localhost:5001/api
