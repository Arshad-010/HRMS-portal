# ========================================================
# HRMS Portal - Root Environment Variables Reference
# ========================================================

# Backend Configuration (copied into backend/.env)
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/hrms_portal
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Admin Initial Bootstrap Credentials (used by npm run seed in backend)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# Frontend Configuration (copied into frontend/.env)
VITE_API_URL=http://localhost:5001/api

# --------------------------------------------------------
# Firebase Google Authentication Configuration
# --------------------------------------------------------

# Frontend Firebase SDK Configuration (copied into frontend/.env)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend Firebase Admin SDK Configuration (copied into backend/.env)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"
